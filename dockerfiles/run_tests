# syntax=docker/dockerfile:1
FROM alpine:3.23.6 AS build
RUN apk add --no-cache meson libgcc musl-dev gcc g++ pkgconf fmt
ARG BUILD_JOBS=2
COPY . /code
WORKDIR /code
RUN --mount=type=cache,id=warthog-test-sources,target=/code/subprojects/packagecache,sharing=locked \
    LDFLAGS='-static' meson setup /build --default-library static --buildtype=release \
    && meson compile -C /build -j "${BUILD_JOBS}" custom_float stratum_job_cache stratum_preparation latency_policy journal_modes sqlite_workload mempool_replacement mempool_reconciliation mempool_admission db_maintenance block_lookup \
    && meson test -C /build --no-rebuild --print-errorlogs
