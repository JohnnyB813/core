{
  "name": "warthog-evernode-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/health.test.ts tests/registry.test.ts tests/http.test.ts tests/client.test.ts tests/reducer.test.ts tests/contract.test.ts tests/controllers.test.ts tests/pool-probe.test.ts",
    "prepare-client": "node deploy/patch-hotpocket.cjs",
    "build:controller": "esbuild controller/entry.ts --bundle --platform=node --target=node16 --format=cjs --outfile=dist/controller/contract.cjs",
    "preflight": "node deploy/preflight.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.11",
    "evernode-js-client": "0.6.61",
    "hotpocket-nodejs-contract": "0.7.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "hotpocket-js-client": "0.5.7"
  }
}
